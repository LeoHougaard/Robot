{
  "required_providers": [
    "native-schema"
  ],
  "required_categories": [
    "explicit",
    "units",
    "stop",
    "ambiguity",
    "planning",
    "limits",
    "unsupported",
    "adversarial",
    "robustness"
  ],
  "min_unique_cases": 100,
