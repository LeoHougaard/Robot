  "min_clarification_recall": 0.95,
  "max_timeout_rate": 0.01,
  "max_provider_error_rate": 0.01,
  "max_invalid_response_rate": 0.01,
  "max_parser_rejected_rate": 0.01,
  "max_expired_rate": 0.01,
  "max_latency_p95_ms": 1000.0
