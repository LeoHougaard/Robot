<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/ink"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/connectionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/looking_for_esp32"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/runtimeStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/policy_idle"
            android:textColor="@color/ink" />

        <androidx.camera.view.PreviewView
            android:id="@+id/cameraPreview"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="16dp"
            android:background="#20272D"
            android:visibility="gone"
            app:implementationMode="performance"
            app:scaleType="fitCenter" />

        <TextView
            android:id="@+id/cameraStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/camera_off"
            android:textColor="@color/ink" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/cameraSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="false"
            android:text="@string/enable_camera" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/standAtStartPoseButton"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:enabled="false"
            android:text="@string/stand_at_start_pose" />

        <TextView
            android:id="@+id/forwardRequestLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/forward_request"
            android:textColor="@color/ink" />

        <com.google.android.material.slider.Slider
            android:id="@+id/forwardSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="0.01"
            android:value="0.12"
            android:valueFrom="0"
            android:valueTo="0.22" />

        <TextView
            android:id="@+id/yawRequestLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/yaw_request"
            android:textColor="@color/ink" />

        <com.google.android.material.slider.Slider
            android:id="@+id/yawSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="0.01"
            android:value="0"
            android:valueFrom="-0.25"
            android:valueTo="0.25" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/startPolicyButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:enabled="false"
            android:minHeight="56dp"
            android:text="@string/start_policy" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/stopButton"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="64dp"
            android:text="@string/stop_and_hold"
            android:textColor="@color/danger"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reconnectButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/reconnect_usb" />

        <TextView
            android:id="@+id/telemetryStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:text="@string/no_telemetry"
            android:textColor="@color/ink"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
